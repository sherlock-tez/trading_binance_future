BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# Telegram bot notification settings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Market-data source. "websocket" (default) streams via WS with REST fallback.
# "rest" disables the websocket entirely and polls closed klines over REST only
# (recommended for close-based strategies, e.g. 1h, on hosts where Binance's
# WS data plane is starved/intermittent). The WS_* knobs below are ignored
# except WS_REST_POLL_SECONDS, which sets the poll interval in rest mode.
MARKET_DATA_MODE=websocket

# Websocket resilience tuning (optional; blank = use defaults).
# WS_STREAM_PATH_MODE: legacy (/stream?streams=), market (/market/stream?streams=), raw (/ws/<stream>)
WS_STREAM_PATH_MODE=legacy
# Seconds with no websocket message before forcing a reconnect.
WS_STALENESS_TIMEOUT=90
# Consecutive zero-data stall reconnects before switching to REST polling.
WS_REST_FALLBACK_AFTER=3
# REST poll interval (seconds) while in fallback mode.
WS_REST_POLL_SECONDS=30
# How often (seconds) to retry the websocket while in REST fallback.
WS_RECOVER_PROBE_SECONDS=300
